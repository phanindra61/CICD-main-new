pipeline {
    agent any

    stages {

        stage('Code Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/phanindra61/CICD-main-new.git'
            }
        }

        stage('Maven Build & Unit Test') {
            steps {
                sh 'mvn clean install'
            }
        }

        stage('Maven Integration Test') {
            steps {
                sh 'mvn verify'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t ci-pipeline .'
            }
        }

        stage('Push Image to DockerHub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerHub',
                        usernameVariable: 'dockerHubUser',
                        passwordVariable: 'dockerHubPass'
                    )
                ]) {
                    sh '''
                        set -e
                        echo "$dockerHubPass" | docker login \
                            -u "$dockerHubUser" --password-stdin
                        docker tag ci-pipeline "$dockerHubUser/ci-pipeline:latest"
                        docker push "$dockerHubUser/ci-pipeline:latest"
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withKubeConfig(credentialsId: 'Kubernetes') {
                    sh '''
                        set -e
                        kubectl apply -f deployment.yaml
                        kubectl apply -f service.yaml
                        kubectl rollout status deployment/mydeploy --timeout=120s
                        kubectl get deployments
                        kubectl get pods
                        kubectl get services
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'
        }
        success {
            echo 'Pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed. Check the stage logs above.'
        }
    }
}
